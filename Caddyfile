{
	admin off
	auto_https off
	persist_config off
	servers {
		# Railway's edge connects from these ranges; take the client IP it saw.
		trusted_proxies static 100.64.0.0/10 152.233.0.0/16 10.0.0.0/8 fc00::/7
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
	log {
		level ERROR
	}
}

:{$PORT} {
	reverse_proxy 127.0.0.1:{$ECH0_INTERNAL_PORT} {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		flush_interval -1
	}
}
